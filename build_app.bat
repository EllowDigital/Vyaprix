@echo off
title Compiling BillFlow EXE
echo =========================================================
echo             BillFlow Advanced Build Tool
echo =========================================================
echo.

:: 1. Define Variables for easy updating later
set APP_NAME=BillFlow
set MAIN_SCRIPT=main.py
set UPX_DIR=C:\Users\Byte\Downloads\upx-5.2.0-win64

:: 2. Verify Python is available
python --version >nul 2>&1
if %ERRORLEVEL% NEQ 0 (
    echo [ERROR] Python is not installed or not added to your system PATH.
    echo Please install Python and try again.
    goto :end
)

:: 3. Ensure PyInstaller is installed and up to date
echo [INFO] Verifying PyInstaller installation...
python -m pip install pyinstaller --upgrade --quiet

:: 4. Pre-Build Cleanup (Clear old corrupted caches)
echo [INFO] Cleaning up old build environments...
if exist build rmdir /s /q build
if exist dist rmdir /s /q dist
if exist "%APP_NAME%.spec" del /q "%APP_NAME%.spec"

:: 5. Execute the PyInstaller Build
echo [INFO] Starting compilation of %APP_NAME%.exe...
echo [INFO] Applying UPX compression and stripping unused modules...
echo.

:: Using caret (^) for multi-line readability
:: Added strict --exclude-module flags to aggressively cut down file size
python -m PyInstaller ^
    --noconfirm ^
    --onefile ^
    --windowed ^
    --name "%APP_NAME%" ^
    --icon="assets/app_logo.ico" ^
    --add-data="assets;assets" ^
    --add-data="fonts;fonts" ^
    --version-file="version_info.txt" ^
    --manifest="%APP_NAME%.exe.manifest" ^
    --upx-dir="%UPX_DIR%" ^
    --exclude-module pandas ^
    --exclude-module numpy ^
    --exclude-module matplotlib ^
    --exclude-module scipy ^
    --exclude-module IPython ^
    --exclude-module notebook ^
    --exclude-module PySide2 ^
    --exclude-module PySide6 ^
    --exclude-module PyQt6 ^
    "%MAIN_SCRIPT%"

:: 6. Check for success, Move EXE, and Post-Build Cleanup
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo [ERROR] The build process failed. Check the error messages above.
) else (
    echo.
    echo [INFO] Build successful! Moving executable and cleaning up temp folders...
    
    :: Move the EXE from the dist folder to the root directory
    move /Y "dist\%APP_NAME%.exe" "%APP_NAME%.exe" >nul
    
    :: Delete the leftover junk generated by PyInstaller
    if exist build rmdir /s /q build
    if exist dist rmdir /s /q dist
    if exist "%APP_NAME%.spec" del /q "%APP_NAME%.spec"

    echo.
    echo =========================================================
    echo [SUCCESS] Compilation complete and fully optimized! 
    echo Your final application is "%APP_NAME%.exe" in this folder.
    echo =========================================================
)

:end
echo.
pause